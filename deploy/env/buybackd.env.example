# Chain RPC endpoint that buybackd submits signed reference-price
# quotes to. Defaults to the local node's RPC listener.
BUYBACKD_RPC_URL=https://127.0.0.1:8081

# Bearer token used to authenticate RPC calls against BUYBACKD_RPC_URL.
# Required -- there is no default.
BUYBACKD_RPC_BEARER_TOKEN=replace-me

# Timeout, in seconds, for each RPC call.
BUYBACKD_RPC_TIMEOUT_SECONDS=15

# Trading pair to fetch and submit a reference price for, as BASE/QUOTE.
BUYBACKD_PAIR=ZNHB/USD

# M-of-N signer quorum required before a quote submission is accepted.
BUYBACKD_THRESHOLD=2

# How often, in seconds, buybackd polls oracles and submits a fresh quote.
BUYBACKD_POLL_INTERVAL_SECONDS=300

# Maximum age, in seconds, of an oracle quote before it is considered stale
# and rejected.
BUYBACKD_MAX_QUOTE_AGE_SECONDS=120

# Comma-separated, ordered list of oracle sources to try. The first source
# in the list that returns a usable quote wins.
BUYBACKD_ORACLE_PRIORITY=manual,nowpayments,coingecko

# Fixed manual rate used when "manual" is included in BUYBACKD_ORACLE_PRIORITY.
# Required only if "manual" is present in that list; otherwise unused.
BUYBACKD_MANUAL_RATE=

# API key for the NOWPayments oracle source. Optional -- only needed when
# "nowpayments" is included in BUYBACKD_ORACLE_PRIORITY.
BUYBACKD_NOWPAYMENTS_API_KEY=

# Comma-separated list of local keystore file paths, one per signer.
# Required -- at least BUYBACKD_THRESHOLD keystores must be configured.
BUYBACKD_KEYSTORE_PATHS=/etc/nhbchain/keystores/buyback-signer-1.json,/etc/nhbchain/keystores/buyback-signer-2.json

# Comma-separated list of environment variable NAMES (not the passphrases
# themselves) holding each keystore's decryption passphrase, index-matched
# to BUYBACKD_KEYSTORE_PATHS. The named variables must also be set in this
# file.
BUYBACKD_KEYSTORE_PASSPHRASE_ENVS=BUYBACK_SIGNER_1_PASSPHRASE,BUYBACK_SIGNER_2_PASSPHRASE

# Passphrase values referenced by name in BUYBACKD_KEYSTORE_PASSPHRASE_ENVS
# above -- keep these secret.
BUYBACK_SIGNER_1_PASSPHRASE=replace-me
BUYBACK_SIGNER_2_PASSPHRASE=replace-me
